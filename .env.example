# === Database (wajib) ===
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# === Panel admin (wajib) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_ini
SESSION_SECRET=isi_dengan_string_acak_panjang_minimal_32_karakter

# === REST API publik (wajib) ===
API_KEY=isi_dengan_api_key_rahasia

# === Chatbot AI — Claude Haiku via overchat.ai ===
# Set ke "true" untuk mengaktifkan auto-reply AI
CHATBOT_ENABLED=true

# (Opsional) Ubah system prompt sesuai karakter bot kamu
# Kalau dikosongkan, pakai default: jawaban natural & singkat
CHATBOT_SYSTEM_PROMPT=Ikuti bahasa user dan jawab dengan gaya natural, singkat, dan jelas.

# === Lingkungan ===
NODE_ENV=production
# PORT=3000
